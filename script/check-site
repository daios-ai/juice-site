#!/usr/bin/env python3
"""Verify a built Jekyll site before it is deployed.

A green Jekyll build only proves the pages compiled. It does not prove that the
navigation, the cross-page links inside an imported manual, or the search index
actually resolve, and those are exactly what break when a permalink or a
baseurl is wrong. This checks the rendered output instead.

Usage: BASEURL=/juice-site python3 script/check-site _site
"""

import json
import os
import re
import sys
from html.parser import HTMLParser
from pathlib import Path
from urllib.parse import unquote, urldefrag, urlparse

# Pages that must exist, and the sidebar the manual must produce.
REQUIRED = [
    "index.html",
    "juice/index.html",
    "juice/getting-started.html",
    "juice/concepts.html",
    "juice/programs.html",
    "juice/calling/index.html",
    "juice/calling/running.html",
    "juice/providing/index.html",
    "juice/operating/index.html",
    "juice/reference/index.html",
]
# The `name` of the collection in _config.yml, as rendered in the sidebar.
NAV_CATEGORY = "Juice manual"
EXPECTED_NAV = [
    "Introduction",
    "Getting started",
    "Concepts",
    "Calling actions",
    "Providing actions",
    "Using Juice from a program",
    "Operating a kernel",
    "Reference",
]


def source_repos(manifest):
    """The repositories manuals are pulled from, read out of manuals.yml.

    Parsed with a regex rather than PyYAML to keep this script dependency-free;
    the manifest is a flat list and `repo:` lines are unambiguous.
    """
    try:
        text = manifest.read_text(encoding="utf-8")
    except OSError:
        return []
    return re.findall(r"^\s*-?\s*repo:\s*([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)\s*$",
                      text, re.M)



class Links(HTMLParser):
    """Collect internal link targets, element ids, and sidebar nav text.

    The sidebar entries wanted are the top-level pages of one collection. Just
    the Docs renders a collection as a `div.nav-category` holding its name,
    followed by the `ul.nav-list` of its pages; with `nav_fold` that pair sits
    inside an outer `ul.nav-category-list`, so the pages are one level deeper
    than an unfolded collection's. Anchoring on the category heading and
    capturing links at exactly the depth of the list that follows it handles
    both, and keeps child pages out.
    """

    ATTRS = {"a": "href", "link": "href", "img": "src", "script": "src"}

    def __init__(self, category=None):
        super().__init__(convert_charrefs=True)
        self.refs = []          # (url, tag)
        self.ids = set()
        self.nav = []           # text of the category's top-level links
        self._category = category
        self._depth = 0         # open ul.nav-list elements
        self._in_cat_div = False
        self._cat_buf = []
        self._armed = False     # category seen, waiting for its page list
        self._cap_depth = None  # depth at which its top-level links sit
        self._nav_a = False
        self._buf = []

    def handle_starttag(self, tag, attrs):
        a = dict(attrs)
        if a.get("id"):
            self.ids.add(a["id"])
        attr = self.ATTRS.get(tag)
        if attr and a.get(attr):
            self.refs.append((a[attr], tag))
        classes = (a.get("class") or "").split()
        if tag == "ul" and "nav-list" in classes:
            self._depth += 1
            if self._armed:
                self._armed, self._cap_depth = False, self._depth
        elif tag == "div" and "nav-category" in classes:
            self._in_cat_div, self._cat_buf = True, []
        elif tag == "a" and "nav-list-link" in classes \
                and self._cap_depth == self._depth:
            self._nav_a, self._buf = True, []

    def handle_endtag(self, tag):
        if tag == "ul" and self._depth:
            if self._cap_depth == self._depth:
                self._cap_depth = None      # the category's list has closed
            self._depth -= 1
        elif tag == "div" and self._in_cat_div:
            self._in_cat_div = False
            name = " ".join("".join(self._cat_buf).split())
            if self._category is None or name == self._category:
                self._armed = True
        elif tag == "a" and self._nav_a:
            self._nav_a = False
            text = " ".join("".join(self._buf).split())
            if text:
                self.nav.append(text)

    def handle_data(self, data):
        if self._in_cat_div:
            self._cat_buf.append(data)
        elif self._nav_a:
            self._buf.append(data)


def parse(path, category=None):
    p = Links(category)
    p.feed(path.read_text(encoding="utf-8", errors="replace"))
    return p


def to_path(url, site, baseurl):
    """Map an internal URL to the file it should resolve to, or None to skip."""
    u = urlparse(url)
    if u.scheme or u.netloc:
        return None                      # external
    path = unquote(u.path)
    if not path:
        return None                      # pure fragment
    if not path.startswith("/"):
        return "RELATIVE"                # resolved by the caller
    if baseurl and (path == baseurl or path.startswith(baseurl + "/")):
        path = path[len(baseurl):] or "/"
    elif baseurl:
        return "OUTSIDE"                 # absolute link that ignores baseurl
    rel = path.lstrip("/")
    if not rel or rel.endswith("/"):
        rel += "index.html"
    return site / rel


def main(argv):
    site = Path(argv[1] if len(argv) > 1 else "_site").resolve()
    baseurl = os.environ.get("BASEURL", "").rstrip("/")
    if not site.is_dir():
        print(f"check-site: {site} is not a directory", file=sys.stderr)
        return 1

    errors, warnings = [], []

    for rel in REQUIRED:
        if not (site / rel).is_file():
            errors.append(f"missing page: {rel}")
    if errors:
        for e in errors:
            print(f"  FAIL {e}")
        print(f"check-site: {len(errors)} required page(s) missing", file=sys.stderr)
        return 1

    pages = sorted(site.rglob("*.html"))
    parsed = {p: parse(p) for p in pages}

    # 1. Homepage links to the manual, through baseurl.
    home = parsed[site / "index.html"]
    want = f"{baseurl}/juice/"
    if not any(h.rstrip() in (want, want + "index.html") for h, _ in home.refs):
        errors.append(f"homepage has no link to {want} "
                      f"(is the link going through the relative_url filter?)")

    # 2. Sidebar order on the manual index. Parsed separately because this one
    #    needs the collection name to locate the right category.
    nav = parse(site / "juice" / "index.html", NAV_CATEGORY).nav
    missing = [t for t in EXPECTED_NAV if t not in nav]
    if missing:
        errors.append(f"sidebar is missing: {', '.join(missing)}")
    else:
        got = [t for t in nav if t in EXPECTED_NAV]
        if got != EXPECTED_NAV:
            errors.append(f"sidebar order is {got}, expected {EXPECTED_NAV}")

    # 3. Every internal link and asset resolves; every fragment exists.
    for page in pages:
        rel_page = page.relative_to(site)
        for url, tag in parsed[page].refs:
            base, frag = urldefrag(url)
            target = to_path(base, site, baseurl)
            if target is None:
                continue
            if target == "OUTSIDE":
                errors.append(f"{rel_page}: absolute link ignores baseurl: {url}")
                continue
            if target == "RELATIVE":
                cand = (page.parent / unquote(base)).resolve()
                if cand.is_dir():
                    cand = cand / "index.html"
                target = cand
            if not target.is_file():
                errors.append(f"{rel_page}: broken {tag} link: {url}")
                continue
            if frag and target.suffix == ".html":
                if frag not in parsed.setdefault(target, parse(target)).ids:
                    errors.append(f"{rel_page}: missing anchor #{frag} in "
                                  f"{target.relative_to(site)}")

    # 4. The install script is served, since a reader pipes it into a shell.
    install = site / "install.sh"
    if not install.is_file() or install.stat().st_size == 0:
        errors.append("install.sh missing or empty (fetch-manuals copies it "
                      "from the manual's repo)")

    # 5. Search index resolves and carries extensions.
    search = site / "assets" / "js" / "search-data.json"
    if not search.is_file():
        errors.append("search index missing: assets/js/search-data.json "
                      "(search_enabled is on)")
    else:
        try:
            data = json.loads(search.read_text(encoding="utf-8"))
        except ValueError as e:
            errors.append(f"search index is not valid JSON: {e}")
            data = {}
        checked = 0
        for item in (data.values() if isinstance(data, dict) else data):
            url = (item or {}).get("url") or ""
            base, _ = urldefrag(url)
            if not base:
                continue
            target = to_path(base, site, baseurl)
            if target in (None, "OUTSIDE", "RELATIVE"):
                errors.append(f"search index entry does not resolve: {url}")
                continue
            if not target.is_file():
                errors.append(f"search index points at a missing page: {url}")
            checked += 1
        if not checked:
            errors.append("search index has no usable entries")

    # 5. Report links back into a manual's own source repository. Those 404 for
    #    visitors while that repository is private. Scoped to the repos in
    #    manuals.yml so the theme's own icon-license links are not counted.
    repos = source_repos(Path(__file__).resolve().parent.parent / "manuals.yml")
    for repo in repos:
        pat = re.compile(r"https://github\.com/" + re.escape(repo) + r"/blob/[^\"'\s>]*")
        hits = {}
        for page in pages:
            found = pat.findall(page.read_text(encoding="utf-8", errors="replace"))
            for url in found:
                hits.setdefault(url, []).append(str(page.relative_to(site)))
        if hits:
            n = sum(len(v) for v in hits.values())
            warnings.append(f"{n} link(s) on {len({p for v in hits.values() for p in v})} "
                            f"page(s) point into {repo}; these 404 for visitors while "
                            f"that repository is private")
            for url in sorted(hits):
                warnings.append(f"    {url.split('/blob/', 1)[1]}  "
                                f"<- {', '.join(sorted(set(hits[url])))}")

    for w in warnings:
        print(f"  WARN {w}")
    if errors:
        for e in errors[:40]:
            print(f"  FAIL {e}")
        if len(errors) > 40:
            print(f"  ... and {len(errors) - 40} more")
        print(f"check-site: {len(errors)} problem(s) in {site}", file=sys.stderr)
        return 1
    print(f"check-site: OK, {len(pages)} page(s) checked in {site}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))

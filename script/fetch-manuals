#!/usr/bin/env python3
"""Fetch each manual listed in manuals.yml into a Jekyll collection directory.

Manuals live in their own repositories. This script downloads the requested
directory from each one and materialises it as `_<name>/` so Jekyll can render
it as a collection. Nothing it writes is committed to this repository.

Credentials: MANUALS_TOKEN in the environment (an Actions secret in CI), or a
local `gh auth token` for development. A private source repo needs one of them.

Safety: everything is extracted into a temporary directory and validated before
any existing `_<name>/` is replaced, so a failed fetch leaves the previous
content in place. Archive members are filtered against path traversal and
links.

Usage: python3 script/fetch-manuals [manuals.yml]
"""

import io
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import urllib.error
import urllib.request
from pathlib import Path

import yaml

API = "https://api.github.com"
NAME_RE = re.compile(r"^[a-z][a-z0-9-]*$")
REPO_RE = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")
# Links the public site cannot serve: blob links into a repo that may be private.
PRIVATE_LINK_RE = re.compile(r"https://github\.com/[^/\s)]+/[^/\s)]+/blob/")

ROOT = Path(__file__).resolve().parent.parent


class Failure(Exception):
    """A fetch that must stop the build."""


def log(msg):
    print(msg, flush=True)


def token():
    """Return a GitHub token, or raise if none can be found."""
    tok = os.environ.get("MANUALS_TOKEN", "").strip()
    if tok:
        return tok
    try:
        out = subprocess.run(
            ["gh", "auth", "token"],
            capture_output=True, text=True, timeout=30,
        )
    except (OSError, subprocess.SubprocessError):
        out = None
    if out is not None and out.returncode == 0 and out.stdout.strip():
        return out.stdout.strip()
    raise Failure(
        "No GitHub credential. Set MANUALS_TOKEN (in CI: an Actions secret with "
        "Contents: read on the manual repositories) or run `gh auth login` locally."
    )


def api_get(url, tok, accept="application/vnd.github+json"):
    req = urllib.request.Request(url, headers={
        "Authorization": f"Bearer {tok}",
        "Accept": accept,
        "X-GitHub-Api-Version": "2022-11-28",
        "User-Agent": "juice-site-fetch-manuals",
    })
    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            return resp.read()
    except urllib.error.HTTPError as e:
        hint = ""
        if e.code in (401, 403):
            hint = " (check the token's scope and that it can read this repository)"
        elif e.code == 404:
            hint = " (repository, ref or path not found, or the token cannot see it)"
        raise Failure(f"GET {url} failed: HTTP {e.code} {e.reason}{hint}") from None
    except urllib.error.URLError as e:
        raise Failure(f"GET {url} failed: {e.reason}") from None


def resolve_ref(repo, ref, tok):
    """Resolve a branch, tag or sha to a full commit sha."""
    body = api_get(f"{API}/repos/{repo}/commits/{ref}", tok)
    try:
        return json.loads(body)["sha"]
    except (ValueError, KeyError):
        raise Failure(f"{repo}: could not read a commit sha for ref {ref!r}") from None


def safe_members(tf, prefix, dest):
    """Yield archive members under `prefix`, rejecting anything unsafe.

    Rejects absolute paths, parent traversal, symlinks and hardlinks. Paths are
    re-rooted so `<top>/<path>/x.md` extracts to `<dest>/x.md`.
    """
    dest = dest.resolve()
    found = False
    for m in tf.getmembers():
        if not (m.name == prefix or m.name.startswith(prefix + "/")):
            continue
        if m.issym() or m.islnk():
            raise Failure(f"archive contains a link, refusing: {m.name}")
        if not (m.isfile() or m.isdir()):
            continue
        rel = m.name[len(prefix):].lstrip("/")
        if not rel:
            continue
        if rel.startswith("/") or ".." in Path(rel).parts:
            raise Failure(f"unsafe path in archive: {m.name}")
        target = (dest / rel).resolve()
        if not str(target).startswith(str(dest) + os.sep):
            raise Failure(f"path escapes destination: {m.name}")
        m.name = rel
        m.mode = 0o755 if m.isdir() else 0o644
        m.uid = m.gid = 0
        m.uname = m.gname = ""
        found = True
        yield m
    if not found:
        raise Failure(f"no files found under {prefix!r} in the archive")


def fetch(entry, tok, tmp):
    name, repo = entry["name"], entry["repo"]
    ref, path = entry["ref"], entry["path"].strip("/")

    sha = resolve_ref(repo, ref, tok)
    log(f"  {name}: {repo}@{ref} -> {sha[:12]} ({path}/)")

    blob = api_get(f"{API}/repos/{repo}/tarball/{sha}", tok,
                   accept="application/vnd.github+json")
    # This endpoint returns the whole repository archive; the directory filter
    # below happens locally. Fine at the sizes involved here. If a source repo
    # ever gets large, switch that entry to a blobless sparse clone.
    dest = tmp / name
    dest.mkdir(parents=True)
    with tarfile.open(fileobj=io.BytesIO(blob), mode="r:gz") as tf:
        first = tf.next()
        if first is None:
            raise Failure(f"{repo}: empty archive")
        top = first.name.split("/", 1)[0]
        tf.extractall(dest, members=safe_members(tf, f"{top}/{path}", dest),
                      filter="data")

    # The manual's own _config.yml configures it as a standalone site. It must
    # not leak into this one.
    stray = dest / "_config.yml"
    if stray.exists():
        stray.unlink()
        log(f"  {name}: dropped the manual's own _config.yml")

    pages = sorted(dest.rglob("*.md"))
    if not pages:
        raise Failure(f"{repo}: {path}/ contains no .md files")

    private = 0
    for p in pages:
        private += len(PRIVATE_LINK_RE.findall(p.read_text(encoding="utf-8", errors="replace")))
    if private:
        log(f"  {name}: WARNING {private} link(s) point at github.com blob URLs; "
            f"these 404 for visitors if the source repo is private")

    return len(pages)


def main(argv):
    manifest = ROOT / (argv[1] if len(argv) > 1 else "manuals.yml")
    try:
        spec = yaml.safe_load(manifest.read_text(encoding="utf-8")) or {}
    except OSError as e:
        raise Failure(f"cannot read {manifest}: {e}") from None
    entries = spec.get("manuals") or []
    if not entries:
        raise Failure(f"{manifest} lists no manuals")

    seen = set()
    for e in entries:
        missing = [k for k in ("name", "repo", "ref", "path") if not e.get(k)]
        if missing:
            raise Failure(f"manual entry {e!r} is missing: {', '.join(missing)}")
        if not NAME_RE.match(e["name"]):
            raise Failure(f"bad manual name {e['name']!r}: expected ^[a-z][a-z0-9-]*$")
        if not REPO_RE.match(e["repo"]):
            raise Failure(f"bad repo {e['repo']!r}: expected owner/name")
        if e["name"] in seen:
            raise Failure(f"duplicate manual name {e['name']!r}")
        seen.add(e["name"])

    tok = token()
    log(f"Fetching {len(entries)} manual(s):")
    counts = {}
    with tempfile.TemporaryDirectory(dir=ROOT, prefix=".fetch-") as td:
        tmp = Path(td)
        for e in entries:
            counts[e["name"]] = fetch(e, tok, tmp)
        # Everything validated; now swap the destinations in.
        for e in entries:
            target = ROOT / f"_{e['name']}"
            if target.exists():
                shutil.rmtree(target)
            shutil.move(str(tmp / e["name"]), str(target))

    for name, n in counts.items():
        log(f"  _{name}/: {n} page(s)")
    log("Done.")


if __name__ == "__main__":
    try:
        main(sys.argv)
    except Failure as exc:
        print(f"fetch-manuals: {exc}", file=sys.stderr)
        sys.exit(1)
